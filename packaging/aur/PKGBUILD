# Maintainer: thunderthome <47116903+thunderthome@users.noreply.github.com>
pkgname=mixrail
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux audio mixer for PipeWire: virtual inputs and outputs, per-app routing, effects and MIDI control"
arch=('x86_64' 'aarch64')
url="https://github.com/thunderthome/mixrail"
license=('GPL-3.0-or-later')
depends=('pipewire' 'pipewire-audio' 'wireplumber' 'alsa-lib' 'gcc-libs' 'glibc')
makedepends=('cargo' 'clang')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('c0c150ef2459535e4ceb5734c602ae1c75ee7532d701d0aedcc0fb87113d6329')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/mixrail "$pkgdir/usr/bin/mixrail"
  install -Dm644 packaging/mixrail.service "$pkgdir/usr/lib/systemd/user/mixrail.service"
  install -Dm644 packaging/mixrail.desktop "$pkgdir/usr/share/applications/mixrail.desktop"
  install -Dm644 assets/icons/mixrail.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/mixrail.svg"
  install -Dm644 packaging/mixrail-tray.desktop "$pkgdir/etc/xdg/autostart/mixrail-tray.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
